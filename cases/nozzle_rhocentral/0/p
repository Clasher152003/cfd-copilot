FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 160000.0;

boundaryField
{
    inlet
    {
        type            totalPressure;
        p0              uniform 200000.0;
        gamma           1.4;
    }
    outlet
    {
        type            fixedValue;
        value           uniform 120000.0;
    }
    wall
    {
        type            zeroGradient;
    }
    wedge_back
    {
        type            wedge;
    }
    wedge_front
    {
        type            wedge;
    }
    centerline
    {
        type            symmetry;
    }
}

